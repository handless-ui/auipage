{
  "name": "auipage",
  "version": "0.1.0",
  "description": "智能体快速开发框架，用于快速开发智能体网页应用。",
  "type": "module",
  "scripts": {
    "prepublishOnly": "node ./scripts/publish.js --mode=error",
    "publish": "npm run build && node ./scripts/publish.js --mode=publish",
    "postinstall": "node ./scripts/postinstall.js && npm run build",
    "build": "node ./scripts/build.js",
    "dev": "node index.js",
    "test": "node test/index.unit.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handless-ui/auipage.git"
  },
  "keywords": [
    "ui",
    "page",
    "agent"
  ],
  "author": "zxl20070701",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/handless-ui/auipage/issues"
  },
  "homepage": "https://github.com/handless-ui/auipage#readme",
  "devDependencies": {
    "@oipage/cli": "0.3.0",
    "@oipage/testjs": "^0.1.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "rollup": "^3.20.6"
  },
  "dependencies": {
    "@auipage/agent": "workspace:^",
    "@auipage/core": "workspace:^",
    "@auipage/fetch": "workspace:^",
    "@auipage/model": "workspace:^",
    "@oipage/browser.js": "^1.1.0",
    "oipage": "^2.1.0"
  }
}